<!--
  home-lab-siem — Custom Wazuh rules
  ----------------------------------
  Each rule is mapped to a MITRE ATT&CK technique and has a corresponding
  playbook entry in docs/detections.md describing triage steps.

  Author: Yassir Zahidi <yassirzahidi8@gmail.com>
  License: MIT
-->

<group name="local,custom,">

  <!-- =========================================================== -->
  <!-- 100100 — SSH brute-force                                    -->
  <!-- MITRE ATT&CK: T1110.001 (Password Guessing)                 -->
  <!-- =========================================================== -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5712</if_matched_sid>
    <same_source_ip />
    <description>SSH brute-force attempt: 5+ failed logins from $(srcip) in 60s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- 100101 — Suspicious PowerShell                              -->
  <!-- MITRE ATT&CK: T1059.001 (PowerShell)                        -->
  <!-- =========================================================== -->
  <rule id="100101" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">
      (?i)(-enc(odedcommand)?\s|IEX\s*\(|DownloadString|Invoke-Mimikatz|FromBase64String)
    </field>
    <description>Suspicious PowerShell command on $(win.system.computer): possible offensive tooling</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- 100102 — Port scan (Suricata-sourced)                       -->
  <!-- MITRE ATT&CK: T1046 (Network Service Scanning)              -->
  <!-- =========================================================== -->
  <rule id="100102" level="9">
    <if_sid>86600</if_sid>
    <field name="alert.signature">SCAN nmap</field>
    <description>Port scan detected from $(src_ip) to $(dest_ip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- 100103 — File integrity violation in protected paths        -->
  <!-- MITRE ATT&CK: T1565.001 (Stored Data Manipulation)          -->
  <!-- =========================================================== -->
  <rule id="100103" level="11">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^(/etc/|C:\\Windows\\System32\\)</field>
    <description>FIM: protected file modified — $(file)</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>syscheck,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- 100104 — Probable web shell upload                          -->
  <!-- MITRE ATT&CK: T1505.003 (Web Shell)                         -->
  <!-- =========================================================== -->
  <rule id="100104" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">
      (?i)(/uploads/.*\.(php|phtml|jsp)$|/wwwroot/uploads/.*\.(aspx|ashx|asp)$)
    </field>
    <description>Possible web shell uploaded: $(file)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,attack,</group>
  </rule>

</group>
